DATABASE_PATH=/workspace/data/hot_monitor.db
X_BEARER_TOKEN=
X_MAX_RESULTS=20
KOL_MIN_FOLLOWERS=200000
# Every day at 08:00 UTC
COLLECTION_CRON=0 8 * * *
# If > 0, takes priority over COLLECTION_CRON
COLLECTION_INTERVAL_MINUTES=0
NEWS_RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://decrypt.co/feed

# Telegram notification and bot command control
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_INTERVAL_SECONDS=20
TELEGRAM_NOTIFY_ON_COLLECT=true
TELEGRAM_HOTSPOT_PUSH_LIMIT=5

# LLM bilingual semantic classification
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# On-chain/ecosystem data sources
DUNE_API_KEY=
DUNE_QUERY_IDS=
DEFILLAMA_ENABLED=true
GITHUB_RELEASE_REPOS=ethereum/go-ethereum,OffchainLabs/nitro
GITHUB_TOKEN=
