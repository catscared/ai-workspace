DATABASE_PATH=/workspace/data/hot_monitor.db
X_BEARER_TOKEN=
X_MAX_RESULTS=20
KOL_MIN_FOLLOWERS=200000
# Every day at 08:00 UTC (used only when interval is 0)
COLLECTION_CRON=0 8 * * *
# Every 4 hours by default
COLLECTION_INTERVAL_MINUTES=240
NEWS_RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://decrypt.co/feed
CHAIN_NEWS_FEEDS=https://cointelegraph.com/tags/bitcoin/rss,https://cointelegraph.com/tags/ethereum/rss,https://cointelegraph.com/tags/solana/rss

# Telegram notification and bot command control
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_INTERVAL_SECONDS=20
TELEGRAM_NOTIFY_ON_COLLECT=true
TELEGRAM_HOTSPOT_PUSH_LIMIT=5

# LLM semantic analysis
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# On-chain/ecosystem data sources
DUNE_API_KEY=
DUNE_QUERY_IDS=
DEFILLAMA_ENABLED=true
GITHUB_RELEASE_REPOS=ethereum/go-ethereum,OffchainLabs/nitro
GITHUB_TOKEN=
GITHUB_TRENDING_ENABLED=true
GITHUB_TRENDING_QUERY=blockchain OR web3 OR crypto OR bitcoin OR ethereum OR solana OR rollup OR zk
GITHUB_TRENDING_MAX_RESULTS=15
GITHUB_TRENDING_MIN_STARS=150

# X default KOL accounts to monitor
X_DEFAULT_KOL_HANDLES=cz_binance,VitalikButerin,aeyakovenko,SBF_FTX,justinsuntron
X_KOL_MAX_RESULTS=20
